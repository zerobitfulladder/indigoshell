{
  "manifest_version": 3,
  "name": "INDIGO bridge",
  "version": "0.2.1",
  "description": "Lets INDIGO, the indigoshell desktop's call agent, use this browser: tabs, pages, forms.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@indigoshell",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "optional_permissions": [
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "INDIGO bridge",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "options.html",
    "default_area": "navbar"
  }
}
